# /opt/fundcompass/.env 로 복사하고 값을 채운 뒤 chmod 600 할 것.
# 이 파일 자체는 절대 커밋하지 않는다.

# RDS 엔드포인트 (콘솔에서 복사)
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/fundcompass
DB_USERNAME=fundcompass
DB_PASSWORD=<RDS 생성 시 정한 비밀번호>

# 공고 자격요건 추출용 (기업마당 공개 문서만 전송)
GEMINI_API_KEY=
BIZINFO_API_KEY=

# 설명 생성용 (사용자 사업자 정보 전송 — 유료 키)
GEMINI_EXPLAIN_API_KEY=

# 신규 공고 자동 수집. 처음엔 false 로 두고 수동 확인 후 켠다
PROGRAM_SYNC_ENABLED=false

# Next 프록시를 쓰면 브라우저가 백엔드를 직접 부르지 않으므로 CORS가 필요 없다.
# 만약 프론트에서 직접 호출하는 구조로 바꾼다면 Vercel 도메인을 넣는다
CORS_ALLOWED_ORIGINS=http://localhost:3000
